# PolyScope Trader — copy to .env and fill placeholders locally

TRADING_MODE=paper
POLYSCOPE_DB_PATH=/data/polyscope.db
POLYSCOPE_HOST=127.0.0.1
POLYSCOPE_PORT=8080

DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me-local-only

# LIVE (disabled by default — all required when TRADING_MODE=live)
LIVE_ARMED=false
LIVE_ARM_TOKEN=
POLYMARKET_PRIVATE_KEY=

LIVE_MAX_FUNDED_BUDGET=
LIVE_MAX_ORDER_COST=
LIVE_MAX_EVENT_EXPOSURE=
LIVE_MAX_TOTAL_EXPOSURE=
LIVE_MAX_OPEN_POSITIONS=
LIVE_MAX_OUTSTANDING_ORDERS=
LIVE_DAILY_LOSS_CIRCUIT_BREAKER=
LIVE_MAX_SPREAD=
LIVE_MAX_SLIPPAGE=
LIVE_MAX_SIGNAL_AGE_SECONDS=
LIVE_MAX_DATA_AGE_SECONDS=

COHORT_MAX_RANK=50
COHORT_MIN_VOLUME=1000
COHORT_LEADERBOARD_WINDOW=day
SIGNAL_PRICE_TOLERANCE=0.02
EXECUTION_LATENCY_MS=500
POLL_INTERVAL_SECONDS=30

# Automation & micro sizing
AUTOMATION_TIER=1
MICRO_MAX_ORDER_COST=0.25
FLOW_CONSENSUS_MIN_WALLETS=1
USE_STREAM_INGEST=false
REPORT_DIR=evidence/reports

# AI research (advisory only — does not place orders)
AI_PROVIDER=none
AI_GATEWAY_API_KEY=
AI_MODEL=gpt-4o-mini

# Optional token for Viktor mobile URL (?token=...) instead of basic auth
VIKTOR_VIEW_TOKEN=
LIVE_SCALED_UNLOCKED=false
